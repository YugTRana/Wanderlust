<%- layout("/layouts/boilerplate.ejs") %>

    <div class="row justify-content-center">
        <div class="col-md-6">
            <h1 class="text-center mb-4">Create New Listing</h1>
            <form action="/listings" method="post" class="needs-validation" novalidate>

                <div class="mb-3">
                    <label for="title">Title : </label>    
                    <input type="text" name="listing[title]" class="form-control" id="title" placeholder="Add Title" required>
                    <!-- these is for a validations  -->
                    <div class="valid-feedback">Title Looks Good!!</div> 
                </div>
                <div class="mb-3">
                    <label for="desc">Description : </label>
                    <textarea name="listing[description]" class="form-control" id="des" rows="4" placeholder="Add Description" required></textarea>
                    <div class="valid-feedback">Description Okk!!</div>
                    <div class="invalid-feedback"> Mention A Description!!</div>
                </div>

                <div class="mb-3">
                    <label for="img">Image Link : </label>
                    <input type="text" name="listing[image]" id="img" class="form-control"placeholder="Enter Image URL">
                    <div class="valid-feedback">Valid!!</div>
                    <div class="invalid-feedback">Add Image Link</div>
                </div>

                <div class="row">
                <div class="mb-3 col-md-4">
                    <label for="num">Price : </label>
                    <input type="number" name="listing[price]" id="num"  class="form-control" placeholder="1200" required>
                    <div class="valid-feedback">Valid!!</div>
                    <div class="invalid-feedback">IN-Valid!!</div>
                </div>
                <div class="mb-3 col-md-8">
                    <label for="con">Country : </label>
                    <input type="text" name="listing[country]" id="con" class="form-control"placeholder="India" required>
                    <div class="valid-feedback">Valid!!</div>
                    <div class="invalid-feedback">IN-Valid!!</div>
                </div>
                </div>
                <div class="mb-3">
                    <label for="loc">Location : </label>
                    <input type="text" name="listing[location]" id="loc" class="form-control" placeholder="Vadodara,surat,Bharuch" required>
                    <div class="valid-feedback">Valid!!</div>
                    <div class="invalid-feedback">IN-Valid!!</div>
                </div>
                <button class="btn btn-dark w-100"> Add Data </button>
            </form>
        </div>
    </div>
    