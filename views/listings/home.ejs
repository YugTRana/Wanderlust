<%- layout("/layouts/boilerplate.ejs") %>

  <div>
    <div class="img">
    </div>
  </div>
  <hr>
  <div class="containt">
    <div class="first-containt">
      <h2>Welcome to Wanderlust – Your Gateway to Extraordinary Stays</h2>
      <p>Your dream destination is just a few clicks away. Wanderlust connects travelers with beautiful places to stay,
        offering verified listings, secure bookings, and unforgettable experiences. Start exploring today and create
        memories that last a lifetime.</p>
    </div>
    <p>Why<b><mark>use</mark></b> wanderlust?</p><br>
    <div class="second-content row g-3">

      <!-- Card 1 -->
      <div class="col-12 col-lg-3">
        <div class="card text-bg-primary mb-3 h-100">
          <div class="card-header">🏡 Verified Listings</div>
          <div class="card-body">
            <p class="card-text">
              Every listing is reviewed to provide authentic information, real photos, and trusted accommodations.
            </p>
          </div>
        </div>
      </div>

      <!-- Card 2 -->
      <div class="col-12 col-lg-3">
        <div class="card text-bg-info mb-3 h-100">
          <div class="card-header">🔒 Secure Experience</div>
          <div class="card-body">
            <p class="card-text">
              Your bookings and personal information remain protected using modern security practices.
            </p>
          </div>
        </div>
      </div>

      <!-- Card 3 -->
      <div class="col-12 col-lg-3">
        <div class="card text-bg-primary mb-3 h-100">
          <div class="card-header">💰 Affordable Prices</div>
          <div class="card-body">
            <p class="card-text">
              Find luxury experiences without paying luxury prices.
            </p>
          </div>
        </div>
      </div>

      <!-- Card 4 -->
      <div class="col-12 col-lg-3">
        <div class="card text-bg-info mb-3 h-100">
          <div class="card-header">🌍 Worldwide Destinations</div>
          <div class="card-body">
            <p class="card-text">
              Explore thousands of beautiful destinations across mountains, beaches, forests, deserts, and cities.
            </p>
          </div>
        </div>
      </div>

    </div>
    <form id="queryForm" class="" method="post" action="/send-query">

      <h4>Email For Any Query</h4>
      <br>
      <div class="mb-3">
        <label for="name" class="form-label">Your Name</label>
        <input type="text" class="form-control" id="name" name="name" placeholder="Enter your name" required>
      </div>

      <div class="mb-3">
        <label for="email" class="form-label">Email Address</label>
        <input type="email" class="form-control" id="email" name="email" placeholder="Enter your email" required>
        <div id="emailHelp" class="form-text">We'll never share your email with anyone else.</div>
      </div>

      <div class="mb-3">
        <label for="message" class="form-label">Your Message</label>
        <textarea class="form-control" id="message" name="message" rows="5" placeholder="Write your message here..."
          required></textarea>
      </div>
      <button type="submit" class="btn btn-primary">Send Message</button>

    </form>
    <p style="color: red;">Email send may take few seconds please bePatient!!</p>
    <script src="/js/script.js"></script>