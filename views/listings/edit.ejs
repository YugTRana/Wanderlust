<%- layout("/layouts/boilerplate.ejs") %>
<div class="row justify-content-center">
      <div class="col-md-8">
    <form method="post" action="/listings/<%= listing._id %>?_method=PUT" method="post" class="needs-validation" novalidate>
             <h1> Edit Data </h1>
        <div class="mb-3">
            <label for="title">Title : </label>
            <input type="text" class="form-control" name="listing[title]" id="title" value="<%= listing.title %>" placeholder="Add Title" required>
        </div>

        <div class="mb-3">
            <label for="desc">Description : </label>
            <textarea name="listing[description]" class="form-control"id="desc" placeholder="Add description" required><%= listing.description %></textarea>
        </div>
        <div class="mb-3">
            <label for="img">Image Link : </label>
            <input type="text" name="listing[image]"class="form-control" id="img" value="<%= listing.image %>" placeholder="Enter ImageUrl" required>
        </div>
        <div class="mb-3">
            <label for="num">Price : </label>
            <input type="number" name="listing[price]"class="form-control" id="num" value="<%= listing.price %>" placeholder="Enter Amount" required>
        </div>
        <div class="mb-3">
            <label for="con">Country : </label>
            <input type="text" name="listing[country]"class="form-control" id="con" value="<%= listing.country %>" placeholder="Enter Country" required>
        </div>
        <div class="mb-3">
            <label for="loc">Location : </label>
            <input type="text" name="listing[location]"class="form-control" id="loc" value="<%= listing.location %>" placeholder="Enter Location" required>
        </div>
        <div class="mb-3">
            <button class="btn btn-dark w-100">Edit Data</button>
        </div>
        </form>
        </div>
</div>
