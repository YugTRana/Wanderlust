<% layout("/layouts/boilerplate") %>

<script>
    let key = "<%= process.env.DEFAULT_KEY %>";
    let cordinates = <%- JSON.stringify(listing.geometry.coordinates) %>;
</script>
    <!-- <h1>WanderLust!!</h1> -->
    <div class="row col-12">
        
        <div class="col-8 offset-2 show-main">
            <h2>
                <%= listing.title %>
            </h2>
            <br>
            <img src="<%= listing.image.url %>" class="card-img-top sh-img" alt="image">
            <div class="card-body">
                <p class="card-text">
                <ul>
                    <!-- here toLocalString function is convert a ruppes in to indian standard type!! -->
                    <div class="info-header">
                        <p><b>Created By :</b> @<%= listing.owner.username %>
                        </p>
                        <p> <b> category :</b> <%- listing.category %></p>

                    </div>
                    <li>
                        <%= listing.description %>
                    </li>
                    <li>
                        Price : ₹ <%= listing.price.toLocaleString("en-IN") %>
                    </li>
                    <li>
                        Country : <%= listing.country %>
                    </li>
                    <li>
                        Location : <%= listing.location %>
                    </li>
                    <br>

                </ul>
                <% if(currUser && currUser._id.equals(listing.owner._id)){ %>

                    <div class="row">
                        <div class="col-12 col-md-5">
                            <p> <a href="/listings/<%= listing._id %>/edit" style="text-decoration: none;"
                                    class="btn btn-edit btn-primary w-100">Edit List</a></p>
                            </p>
                        </div>
                        <div class="col">
                            <div class="col-12 col-md-10">
                                <form class="btn2" action="/listings/<%= listing._id %>?_method=DELETE" method="POST"
                                    onsubmit="confirmDelete(event)">
                                    <button type="submit" class="btn btn-del w-100">Delete Listing</button>
                                </form>
                            </div>
                        </div>
                    </div>
                    <% } %>
            </div>
        </div>
        <hr>
        <% if(currUser){ %>
            <div class="col-8  review">
                <h1>Write a Reviews</h1>
                <form action="/listings/<%= listing._id %>/reviews" method="post" novalidate class="needs-validation">
                    <div>
                        <label for="rating" class="form-label">Rating : </label>
                        <fieldset class="starability-grow" >
                            <input type="radio" id="no-rate" class="input-no-rate" name="reviews[rating]" value="0"
                                checked aria-label="No rating." required />
                            <input type="radio" id="first-rate1" name="reviews[rating]" value="1" />
                            <label for="first-rate1" title="Terrible">1 star</label>
                            <input type="radio" id="first-rate2" name="reviews[rating]" value="2" />
                            <label for="first-rate2" title="Not good">2 stars</label>
                            <input type="radio" id="first-rate3" name="reviews[rating]" value="3" />
                            <label for="first-rate3" title="Average">3 stars</label>
                            <input type="radio" id="first-rate4" name="reviews[rating]" value="4" />
                            <label for="first-rate4" title="Very good">4 stars</label>
                            <input type="radio" id="first-rate5" name="reviews[rating]" value="5" checked />
                            <label for="first-rate5" title="Amazing">5 stars</label>
                        </fieldset>
                    </div>
                    <div>
                        <label for="comment" class="form-label">Comment : </label>
                        <textarea name="reviews[comment]" class="form-control" id="comment" rows="5" cols="50"
                            required></textarea>
                        <div class="invalid-feedback"> Write A truth Comment!!</div>
                        <div class="valid-feedback">Looks Better!!</div>
                    </div>
                    <button class="btn btn-sh btn-dark">
                        Submit
                    </button>
                </form>
            </div>
            <% }else{ %>
                <div style="text-align: center;">
                    <p><b>Login</b> to Write Review!!</p>
                </div>
                <% } %>
                    <hr>
                    <div class="row g-3 dis-reviews">
                        <h4 class="mb-3">All Reviews</h4>

                        <% if (listing.reviews && listing.reviews.length> 0) { %>
                            <% for (let review of listing.reviews) { %>
                                <!-- <%= review %> -->
                                <div class="col-md-6 col-lg-4 mb-3">
                                    <div class="card">
                                        <div class="card-body">
                                            <h5 class="card-title">@<%= review.reviewOwner.username %>
                                            </h5>
                                            <hr>
                                            <h6 class="card-subtitle mb-2 text-body-secondary">
                                                <p class="starability-result" data-rating="<%=review.rating%>"> </p>
                                                <!-- Rating: <%= review.rating %> -->
                                            </h6>
                                            <p class="card-text">
                                                Comment: <%= review.comment %>
                                            </p>
                                        </div>
                                        <% if(currUser && review && review.reviewOwner.equals(currUser._id)){ %>
                                            <form
                                                action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE"
                                                method="POST">
                                                <button class="btn btn-sm btn-dark">Delete</button>
                                            </form>
                                            <% } %>
                                    </div>
                                </div>
                                <% } %>
                                    <% } else { %>
                                        <p class="text-muted rev-last">No reviews yet.</p>
                                        <% } %>
                    </div>

                    <div class="map">
                        <h3>Location</h3>
                        <div id="map"></div>
                    </div>
                     <script src="/js/javascript.js"></script>
                     <p style="color: red;">These location is for refrence!! Only These not seen you a Proper Place of Listing!!</p>
                   
    </div>
    </div>
  