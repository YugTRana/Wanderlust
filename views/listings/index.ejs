<% layout("/layouts/boilerplate") %>
    <!-- <h1>All Listings</h1> -->
    <div class="container col">
        <div class="row row-cols-lg-4 row-cols-md-3 row-cols-1">
            <% for(let listing of allListings){ %>

                <div class="col card card-index">
                    <a href="/listings/<%= listing._id %>" class="listing-link">
                        <abbr title="<%=listing.title%>">
                            <img src="<%= listing.image.url %>" class="card-img-top index-img" alt="image"
                                style="height: 20rem"></abbr>
                        <!-- <div class="card-img-overlay">abc</div> -->
                        <div class="card-body card-index-body">
                            <h5 class="card-title">
                                <%= listing.title %>
                            </h5>
                            <p class="card-text">
                                -- <%= listing.description %>
                            </p>
                            <p class="card-text">
                                <b>₹ <%= listing.price.toLocaleString("en-IN")%></b> / night
                            </p>
                            <p class="card-text">
                                <b>Location : </b><%= listing.location %>
                            </p>
                    </a>
                </div>
        </div>
        <% } %>
    </div>
    </div>