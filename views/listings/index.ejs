<% layout("/layouts/boilerplate") %>
        <h1>All Listings</h1>
    <div class="container col">
        <div class="row row-cols-lg-3 row-cols-md-2 row-cols-1">
            <% for(let listing of allListings){ %>
                
                    <div class="col card card-index">
                        <a href="/listings/<%= listing._id %>" class="listing-link">
                            <abbr title="<%=listing.title%>"> 
                    <img src="<%= listing.image %>" class="card-img-top" alt="image" style="height: 20rem"></abbr>
                         <!-- <div class="card-img-overlay">abc</div> -->
                    <div class="card-body card-index-body">
                        <h5 class="card-title">
                            <%= listing.title %>
                        </h5>
                        <p class="card-text">
                        -- <%= listing.description %>
                        </p>
                        <p class="card-text">
                            <b>₹ <%= listing.price.toLocaleString("en-IN")%></b> / night
                        </p>
                    </a>
                    </div>
                    
                </div>
                <% } %>
        </div>
    </div>